# ---------------------------------------------------------------------------
# Line endings: normalize every text file to LF in the repository and check
# out LF on every platform. Keeps Windows checkouts byte-identical to CI and
# to Linux/macOS contributors, so diffs never turn into whitespace noise.
# ---------------------------------------------------------------------------
* text=auto eol=lf

# ---------------------------------------------------------------------------
# Binary assets: never normalized, never line-ending converted.
# ---------------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.exe binary
*.bin binary

# ---------------------------------------------------------------------------
# The vendored TL schema must stay byte-stable across platforms: the drift
# guard (tests/contract.rs) compares it against grammers-tl-types' api.tl,
# which is LF. Force LF so autocrlf never rewrites the comparison target.
# ---------------------------------------------------------------------------
tl/api.tl text eol=lf

# ---------------------------------------------------------------------------
# Embedded assets: include_str! bytes are asserted by tests expecting LF.
# ---------------------------------------------------------------------------
src/commands/skill.md text eol=lf
