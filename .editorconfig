# EditorConfig: https://editorconfig.org
# Keeps indentation and line endings identical across editors, matching the
# LF normalization enforced by .gitattributes.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Byte-exact assets: trailing whitespace is significant because tests compare
# these files verbatim, and trimming would silently break them.
[tl/api.tl]
trim_trailing_whitespace = false

[src/commands/skill.md]
trim_trailing_whitespace = false
